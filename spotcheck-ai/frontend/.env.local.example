# frontend/.env.local.example
# このファイルをコピーして frontend/.env.local を作成する。
# 未設定でもアプリは起動する（地図はフォールバック表示になる）。

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google Maps JavaScript API キー。未設定時は緯度経度の手入力フォームにフォールバックする
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 地図の初期中心（渋谷駅周辺）
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=35.6595
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=139.7005
