# backend/.env.example
# このファイルをコピーして backend/.env を作成する。
# 値が未設定でもアプリは起動する（起動ログに不足変数の警告が出る）。

# --- アプリ ---
APP_ENV=development
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- データベース ---
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/spotcheck

# --- 認証（ログインID＋パスワード / JWT）---
# 未設定なら開発用の固定鍵で署名する（誰でも偽造できるため開発時のみ）。
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
#JWT_EXPIRE_DAYS=30               # ログイン状態を保持する日数
#BCRYPT_ROUNDS=12                 # パスワードハッシュのコスト

# --- Supabase ---
# Dashboard → Settings → API Keys から取得する
SUPABASE_URL=
SUPABASE_SECRET_KEY=              # sb_secret_... （サーバー専用。フロントに渡さない）
#SUPABASE_SERVICE_ROLE_KEY=       # 旧方式のJWT。2026年末に廃止予定。上が未設定のときのみ使われる
STORAGE_BUCKET_RAW=submissions-raw               # 原本（非公開・クライアントに渡さない）
STORAGE_BUCKET_PROCESSED=submissions-processed   # マスキング済み（非公開・署名URLで配信）

# ストレージ実装の選択: auto / supabase / local
#   auto  … SUPABASE_URL と SUPABASE_SERVICE_ROLE_KEY が揃っていれば supabase、無ければ local
STORAGE_BACKEND=auto
LOCAL_STORAGE_DIR=./.storage                     # local バックエンド時の保存先

# --- OrcaRouter（docs/04-ai-pipeline.md 1節。OpenAI Chat Completions 互換）---
ORCA_API_BASE_URL=https://api.orcarouter.ai/v1
ORCA_API_KEY=
# model には「ルーター名」を入れる。モデル名を直書きしてはならない。
ORCA_ROUTER_LIGHT=orcarouter/auto
ORCA_ROUTER_VISION=orcarouter/auto
ORCA_TIMEOUT_SECONDS=60
ORCA_MAX_RETRIES=2
# true、または ORCA_API_KEY 未設定のときは HTTP通信せず固定レスポンスを返す
ORCA_STUB_MODE=false

# --- 判定パラメータ（チューニング可能な初期値）---
TASK_REVIEW_SCORE_THRESHOLD=70      # 依頼情報の十分性スコア。これ未満は補足要求
SUBMISSION_SCORE_THRESHOLD=70       # 画像検品スコア。これ未満は再撮影要求
MAX_RETAKE_COUNT=2                  # 再撮影の上限回数（提出は最大3回）
LOCATION_TOLERANCE_METERS=100       # 依頼地点と撮影地点の許容距離
TIMESTAMP_TOLERANCE_SECONDS=300     # 端末時刻とサーバー受信時刻の許容差
CAPTURE_FRESHNESS_SECONDS=600       # 撮影から送信までの許容経過時間

# --- 物体検出 ---
YOLO_MODEL_PATH=./models_weights/yolov8n.pt
YOLO_FACE_MODEL_PATH=./models_weights/yolov8n-face.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
BLUR_KERNEL_RATIO=0.15              # 対象領域の短辺に対するぼかし強度比

# --- 画像制約 ---
MAX_UPLOAD_SIZE_MB=15
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
